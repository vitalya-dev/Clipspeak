[Unit]
Description=Silero TTS HTTP Server (Russian)
After=network.target

[Service]
Type=simple
# Шаблон: systemd/silero-ru.service.in
# Пути, голос и число потоков подставляет scripts/install.sh
ExecStart=@REPO@/tts/.venv/bin/python @REPO@/tts/silero_server.py --model @REPO@/tts/models/v5_6_ru.pt --speaker @SPEAKER@ --port 5002 --lang @LANG@ --threads @THREADS@
WorkingDirectory=@REPO@/tts
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
